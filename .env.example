# Copie para .env e substitua por uma senha forte. Nunca versione o arquivo .env real.
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST_PORT=5433
SMTP_HOST_PORT=2525
HEALTH_HOST_PORT=8085

# Development ou SmtpRelay
DELIVERY_MODE=Development

# Preencha apenas para DELIVERY_MODE=SmtpRelay. Nunca versione valores reais.
SMTP_RELAY_HOST=CHANGE_ME
SMTP_RELAY_PORT=587
SMTP_RELAY_USERNAME=CHANGE_ME
SMTP_RELAY_PASSWORD=CHANGE_ME
SMTP_RELAY_FROM_ADDRESS=CHANGE_ME
SMTP_RELAY_FROM_NAME=AnInfo Mail Server
SMTP_RELAY_USE_STARTTLS=true
SMTP_RELAY_USE_SSL=false
SMTP_RELAY_PRESERVE_ORIGINAL_FROM=false
SMTP_RELAY_TIMEOUT_SECONDS=30
